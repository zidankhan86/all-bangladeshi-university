{
    "name": "nexcoreit/bangladesh-universities",
    "description": "Bangladesh public and private universities dataset and Laravel query helpers.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "bangladesh",
        "universities",
        "ugc",
        "dataset"
    ],
    "authors": [
        {
            "name": "NexCoreIT"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "NexCoreIT\\BangladeshUniversities\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NexCoreIT\\BangladeshUniversities\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NexCoreIT\\BangladeshUniversities\\BangladeshUniversitiesServiceProvider"
            ],
            "aliases": {
                "Universities": "NexCoreIT\\BangladeshUniversities\\Facades\\Universities"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
